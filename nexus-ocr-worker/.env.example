# Copie ce fichier en ".env" (sans ".example") et remplis les valeurs
# réelles. Ne partage JAMAIS le .env rempli — SUPABASE_SERVICE_KEY donne un
# accès total à la base, sans passer par la sécurité RLS.

SUPABASE_URL=https://uzhjpqpctpvxytxpxoqz.supabase.co

# Dashboard Supabase > Project Settings > API > Project API keys > service_role
# (clé secrète, différente de la clé publique déjà utilisée dans NEXUS)
SUPABASE_SERVICE_KEY=colle_ici_la_cle_service_role

# Site NEXUS que ce worker dessert (un worker = un site pour l'instant)
NEXUS_SITE=vito-sainte-marie

# Mode du moteur : "local" en V1 (seul mode implémenté). "cloud" arrivera en
# V2 sans que ce fichier ni les tables Supabase ne changent.
NEXUS_OCR_MODE=local

# Valeur informative, affichée dans NEXUS si besoin de savoir où tourne le
# worker (imac, railway, flyio…)
NEXUS_WORKER_HOST=imac

# Optionnel (07/08/2026) : dossier local à surveiller pour un dépôt
# automatique de fichiers (ex : là où ton scanner enregistre les bons
# scannés). Laisse cette ligne en commentaire/absente pour désactiver
# cette fonctionnalité — rien d'autre ne change dans le worker.
# Un fichier traité avec succès est déplacé dans un sous-dossier "Traités"
# créé automatiquement, pour ne jamais le réimporter deux fois.
# NEXUS_DOSSIER_SURVEILLE=/Users/fredericbragance/Desktop/SCANVITO
